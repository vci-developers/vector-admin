# Server only. Never prefix with NEXT_PUBLIC_ or add to next.config env.
API_BASE_URL=
ADMIN_AUTH_TOKEN=
# SharePoint "Anyone" link to the coverage workbook; unset uses the saved copy.
COVERAGE_WORKBOOK_URL=
# Private Vercel Blob store keeping the last good workbook, set by connecting the
# store on Vercel; unset falls back straight to the committed copy.
BLOB_READ_WRITE_TOKEN=
# Stakeholders: comma-separated email:programId|programId, e.g. a@who.int:1,b@jhu.edu:1|4
STAKEHOLDER_EMAILS=
